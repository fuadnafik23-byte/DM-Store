datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

// ... di bawah ini tetap biarkan model tabel Anda (orders, users, dll.)

// Tulis atau tempel (paste) model tabel Anda di bawah ini, contoh:
model orders {
  id         Int      @id @default(autoincrement())
  nama       String   @db.VarChar(255)
  game      String   @db.VarChar(100)
  nominal    String   @db.VarChar(100)
  whatsapp  String   @db.VarChar(50)
  status     String   @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp
}